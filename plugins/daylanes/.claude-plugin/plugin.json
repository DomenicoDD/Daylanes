{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "daylanes",
  "displayName": "Daylanes",
  "version": "0.1.0",
  "description": "Connects Claude to Daylanes, the local Mac time tracker for consultants: ask about hours, agent usage and costs per client and project, and write the daily project Diary. Requires the Daylanes app on macOS.",
  "author": {
    "name": "Domenico Marco Di Donna",
    "email": "support@daylanes.app",
    "url": "https://daylanes.app"
  },
  "homepage": "https://daylanes.app",
  "repository": "https://github.com/DomenicoDD/Daylanes",
  "license": "MIT",
  "keywords": [
    "time-tracking",
    "timesheet",
    "billing",
    "invoicing",
    "agent-usage",
    "diary",
    "standup",
    "macos"
  ],
  "network": {
    "hosts": []
  },
  "skills": "./skills/",
  "mcpServers": {
    "daylanes": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/daylanes",
      "args": [
        "mcp"
      ]
    }
  }
}
